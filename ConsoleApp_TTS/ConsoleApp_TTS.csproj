<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.29.0" />
    <PackageReference Include="NumSharp" Version="0.60.0" />
    <PackageReference Include="ToolGood.Words" Version="3.1.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- CMU Pronouncing Dictionary（精簡版），編譯進 exe 供英文 G2P 查詢單字發音 -->
    <EmbeddedResource Include="cmudict.txt" />
  </ItemGroup>

</Project>
