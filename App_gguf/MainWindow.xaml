<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="App_gguf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App_gguf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Activated="Window_Activated"
    Title="GitHub Copilot Chat">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="8,0,8,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom title bar drag region: transparent so it shows the window/Mica background -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <TextBlock
                x:Name="AppTitleTextBlock"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="GitHub Copilot Chat" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="New conversation" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button ToolTipService.ToolTip="Conversation history" Content="History" />
                <Button
                    AutomationProperties.Name="Start a new conversation"
                    ToolTipService.ToolTip="Start a new conversation">
                    <SymbolIcon
                        Symbol="Add"
                        Foreground="{ThemeResource SystemControlHighlightAccentBrush}" />
                </Button>
                <Button ToolTipService.ToolTip="More actions" Content="..." />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="40"
                    Glyph="&#xE8BD;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Text="Ask"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Text="Explore and understand your codebase."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Text="Copilot can make mistakes, so always check its answers."
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="3"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="8">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <Button
                        AutomationProperties.Name="Add context"
                        ToolTipService.ToolTip="Add context">
                        <SymbolIcon
                            Symbol="Add"
                            Foreground="{ThemeResource SystemControlHighlightAccentBrush}" />
                    </Button>
                    <Button Content="Use a file" />
                    <Button Content="Clear context" />
                </StackPanel>

                <TextBox
                    Grid.Row="1"
                    PlaceholderText="Ask Copilot"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MinHeight="48"
                    BorderThickness="0" />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="1"
                        AutomationProperties.Name="Send message"
                        ToolTipService.ToolTip="Send message">
                        <SymbolIcon Symbol="Send" />
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
