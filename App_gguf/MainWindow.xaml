<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="App_gguf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App_gguf"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Activated="Window_Activated"
    Title="GitHub Copilot Chat">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="8,0,8,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <TextBlock
                x:Name="AppTitleTextBlock"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="GitHub Copilot Chat" />
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="New conversation" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                <Button ToolTipService.ToolTip="Conversation history" Content="History" />
                <Button
                    AutomationProperties.Name="Start a new conversation"
                    ToolTipService.ToolTip="Start a new conversation">
                    <SymbolIcon
                        Symbol="Add"
                        Foreground="{ThemeResource SystemControlHighlightAccentBrush}" />
                </Button>
                <Button ToolTipService.ToolTip="More actions" Content="..." />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind EmptyStateVisibility(LLamaCpp.Historys.Count), Mode=OneWay}">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="40"
                    Glyph="&#xE8BD;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Text="Ask"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Text="Explore and understand your codebase."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Text="Copilot can make mistakes, so always check its answers."
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ScrollViewer
                x:Name="ConversationScrollViewer"
                Padding="0,0,0,8"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollMode="Enabled"
                VerticalScrollBarVisibility="Auto"
                Visibility="{x:Bind ConversationVisibility(LLamaCpp.Historys.Count), Mode=OneWay}">
                <ItemsRepeater
                    x:Name="ConversationList"
                    ItemsSource="{x:Bind LLamaCpp.Historys}">
                    <ItemsRepeater.Layout>
                        <StackLayout />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <local:HistoryTemplateSelector>
                            <local:HistoryTemplateSelector.UserTemplate>
                                <DataTemplate x:DataType="local:History">
                                    <Border
                                        Margin="40,4,0,4"
                                        Padding="10,6"
                                        HorizontalAlignment="Right"
                                        Background="{ThemeResource SystemControlHighlightAccentBrush}"
                                        CornerRadius="8">
                                        <TextBlock
                                            Text="{x:Bind Message, Mode=OneWay}"
                                            TextWrapping="Wrap"
                                            Foreground="White" />
                                    </Border>
                                </DataTemplate>
                            </local:HistoryTemplateSelector.UserTemplate>
                            <local:HistoryTemplateSelector.AssistantTemplate>
                                <DataTemplate x:DataType="local:History">
                                    <Border
                                        Margin="0,4,40,4"
                                        Padding="10,6"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <controls:MarkdownTextBlock Text="{x:Bind Message, Mode=OneWay}" />
                                    </Border>
                                </DataTemplate>
                            </local:HistoryTemplateSelector.AssistantTemplate>
                            <local:HistoryTemplateSelector.ToolCallTemplate>
                                <DataTemplate x:DataType="local:History">
                                    <Border
                                        Margin="20,4"
                                        Padding="4"
                                        HorizontalAlignment="Stretch"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                        <Expander
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            IsExpanded="False">
                                            <Expander.Header>
                                                <TextBlock
                                                    Text="{x:Bind Title, Mode=OneWay}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource SystemControlHighlightAccentBrush}" />
                                            </Expander.Header>
                                            <TextBlock
                                                Margin="8,4,8,8"
                                                Text="{x:Bind Message, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                        </Expander>
                                    </Border>
                                </DataTemplate>
                            </local:HistoryTemplateSelector.ToolCallTemplate>
                            <local:HistoryTemplateSelector.ToolResultTemplate>
                                <DataTemplate x:DataType="local:History">
                                    <Border
                                        Margin="20,4"
                                        Padding="4"
                                        HorizontalAlignment="Stretch"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                        <Expander
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            IsExpanded="False">
                                            <Expander.Header>
                                                <TextBlock
                                                    Text="{x:Bind Title, Mode=OneWay}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Expander.Header>
                                            <TextBlock
                                                Margin="8,4,8,8"
                                                Text="{x:Bind Message, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                        </Expander>
                                    </Border>
                                </DataTemplate>
                            </local:HistoryTemplateSelector.ToolResultTemplate>
                        </local:HistoryTemplateSelector>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>

        <Border
            Grid.Row="3"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="8">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <Button
                        AutomationProperties.Name="Add context"
                        ToolTipService.ToolTip="Add context">
                        <SymbolIcon
                            Symbol="Add"
                            Foreground="{ThemeResource SystemControlHighlightAccentBrush}" />
                    </Button>
                    <Button Content="Use a file" />
                    <Button Content="Clear context" />
                </StackPanel>

                <TextBox
                    x:Name="InputTextBox"
                    Grid.Row="1"
                    PlaceholderText="Ask Copilot"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MinHeight="100"
                    BorderThickness="0"
                    Text="{x:Bind LLamaCpp.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{x:Bind LLamaCpp.IsInputEnabled, Mode=OneWay}"
                    KeyDown="InputTextBox_KeyDown" />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind LLamaCpp.TokenStatus, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        Grid.Column="1"
                        AutomationProperties.Name="Send message"
                        ToolTipService.ToolTip="Send message"
                        Command="{x:Bind LLamaCpp.SendCommand}">
                        <SymbolIcon Symbol="Send" />
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
